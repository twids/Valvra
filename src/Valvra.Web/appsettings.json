{
  "FileLogging": {
    "Enabled": true,
    "Path": "Logs/valvra-.jsonl",
    "MinimumLevel": "Information",
    "FileSizeLimitBytes": 10485760,
    "RetainedFileCountLimit": 31
  },
  "Logging": { "LogLevel": { "Default": "Warning", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Error" } },
  "AllowedHosts": "localhost",
  "VaultDatabase": { "Provider": "SqlServer", "ConnectionString": "" },
  "AuditDatabase": {
    "Provider": "SqlServer", "WriterConnectionString": "", "ReaderConnectionString": "",
    "SigningCertificateThumbprint": "", "VerificationCertificateThumbprints": [], "CommandTimeoutSeconds": 10
  },
  "KeyProtection": { "ActiveThumbprint": "", "AllowedThumbprints": [] },
  "ActiveDirectory": {
    "Server": "", "Port": 636, "BaseDn": "", "UserSearchBaseDn": "", "GroupSearchBaseDn": "", "TimeoutSeconds": 10
  },
  "LdapTests": { "Profiles": [] }
}
